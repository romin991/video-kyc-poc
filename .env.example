# API
PORT=3001
# Reference Vite customer origin. The Go API uses this value when it is set.
# For the Next.js customer app, export CUSTOMER_APP_ORIGIN=http://127.0.0.1:3002
# before `go run` so join links point at that shell.
CUSTOMER_APP_ORIGIN=http://localhost:5174
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Company stack (Go API + Next.js). Unset, the Go API allows the Next apps on
# ports 3000 and 3002 as well as the Vite reference ports above.
# NEXT_PUBLIC_API_BASE=http://127.0.0.1:3001
# NEXT_PUBLIC_LIVEKIT_URL=

# Vite apps load this file from the repo root. VITE_LIVEKIT_URL is the same
# WebSocket URL as LIVEKIT_URL, for example wss://your-project.livekit.cloud
VITE_API_BASE=http://localhost:3001
VITE_LIVEKIT_URL=

# LiveKit. Leave all three blank to run the session shell with no cameras.
# Create a free project at https://cloud.livekit.io
# Project settings show the WebSocket URL. Settings → Keys shows the key and secret.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Call recording uses LIVEKIT_URL, LIVEKIT_API_KEY, and LIVEKIT_API_SECRET.
# Room composite egress writes recordings/{room_name}-{time}.mp4.
# Leave the bucket blank to use storage configured on the LiveKit Cloud project.
# Set the bucket (and keys, unless the project storage already has them) to
# pass S3 on the StartEgress request. Never commit real values.
EGRESS_S3_BUCKET=
EGRESS_S3_REGION=
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
EGRESS_S3_ENDPOINT=
EGRESS_S3_FORCE_PATH_STYLE=
EGRESS_FILEPATH=recordings/{room_name}-{time}.mp4
# Optional HTTPS origin for object keys when egress location is s3:// rather than https://
EGRESS_PUBLIC_BASE_URL=
# Origin the API uses when it POSTs a recording onto the session.
# Unset locally uses http://127.0.0.1:$PORT. On Vercel, unset uses https://$VERCEL_URL.
# VERCEL and VERCEL_URL are set by the platform. Do not commit values.
RECORDING_ATTACH_ORIGIN=

# Disposition stubs. Leave a webhook blank to append a JSON line to the log
# instead. Relative log paths resolve from the repo root.
# CRM_STUB_WEBHOOK_URL=http://127.0.0.1:4000/crm
# DATALAKE_STUB_WEBHOOK_URL=http://127.0.0.1:4000/datalake
# DISPOSITION_STUB_LOG_PATH=data/disposition-stubs.jsonl
